        {
          "type": "text",
          "plain_text": "Scandinavian design gets written up as serious, which misses the dry wit running underneath it. ",
          "href": null,
          "text": {
            "content": "Scandinavian design gets written up as serious, which misses the dry wit running underneath it. ",
            "link": null
          },
          "annotations": {
            "bold": false,
            "italic": false,
            "code": false,
            "strikethrough": false,
            "underline": false
          }
        },
        {
          "type": "text",
          "plain_text": "Mean Snothing",
          "href": "/product/mean-snothing",

    "paragraph": {
      "rich_text": [
        {
          "type": "text",
          "plain_text": "Glass looks better and stays flat. Acrylic is lighter, does not shatter, and is the sensible choice above a bed, in a child's room, or anywhere a door slams. If the wall faces a window, anti-reflective glazing costs more and is the only upgrade you will notice every single day.",
          "href": null,
          "text": {
            "content": "Glass looks better and stays flat. Acrylic is lighter, does not shatter, and is the sensible choice above a bed, in a child's room, or anywhere a door slams. If the wall faces a window, anti-reflective glazing costs more and is the only upgrade you will notice every single day.",
            "link": null
          },
          "annotations": {

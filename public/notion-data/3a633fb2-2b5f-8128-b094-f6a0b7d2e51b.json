  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Henie Onstad Kunstsenter sits on a low green promontory at Hovikodden, water on three sides, about 12 km west of the centre of Oslo. It was founded in 1968 by Sonja Henie, the three-time Olympic figure-skating champion who went on to a Hollywood career, and her husband Niels Onstad, a shipping magnate and collector. They gave both the art and the money to build the place, and they chose the word kunstsenter, art centre, over museum quite deliberately: somewhere that makes new work as readily as it keeps the old. Nearly sixty years on, the collection runs to more than 8,000 pieces and the building still feels like it was put there to catch the light off the fjord.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Henie Onstad Kunstsenter sits on a low green promontory at Hovikodden, water on three sides, about 12 km west of the centre of Oslo. It was founded in 1968 by Sonja Henie, the three-time Olympic figure-skating champion who went on to a Hollywood career, and her husband Niels Onstad, a shipping magnate and collector. They gave both the art and the money to build the place, and they chose the word kunstsenter, art centre, over museum quite deliberately: somewhere that makes new work as readily as it keeps the old. Nearly sixty years on, the collection runs to more than 8,000 pieces and the building still feels like it was put there to catch the light off the fjord.",
     "href": null
    }
   ],
   "icon": null,

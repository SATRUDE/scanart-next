  "last_edited_by": {
   "object": "user",
   "id": "a75acbb5-0a51-455f-8c43-d19569c34453"
  },
  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Yes — and it is worth accounting for. A frame adds roughly 3-5cm to each side of the print, depending on the frame profile. So an A2 print in a frame will have an overall dimension closer to 48 x 65cm. This is worth measuring if you are fitting art into a specific wall space, such as between two windows or above a piece of furniture with limited clearance.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Yes — and it is worth accounting for. A frame adds roughly 3-5cm to each side of the print, depending on the frame profile. So an A2 print in a frame will have an overall dimension closer to 48 x 65cm. This is worth measuring if you are fitting art into a specific wall space, such as between two windows or above a piece of furniture with limited clearance.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false

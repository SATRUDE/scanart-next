  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "If you are torn between two sizes, our advice is to go with the larger option. Art that is too small for a space tends to look like an afterthought. A slightly oversized piece, on the other hand, creates intentional impact. It is far more common to regret going too small than too large.",
      "link": null
     },
     "annotations": {

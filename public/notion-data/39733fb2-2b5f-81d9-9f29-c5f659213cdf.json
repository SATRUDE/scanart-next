  "has_children": false,
  "in_trash": false,
  "type": "paragraph",
  "paragraph": {
   "rich_text": [
    {
     "type": "text",
     "text": {
      "content": "Here is a trick that interior designers use: cut a piece of paper or newspaper to the exact dimensions of the print size you are considering. Tape it to the wall where you plan to hang the artwork. Live with it for a day or two. You will quickly get a sense of whether the size feels right for the space — and it costs nothing to test.",
      "link": null
     },
     "annotations": {
      "bold": false,
      "italic": false,
      "strikethrough": false,
      "underline": false,
      "code": false,
      "color": "default"
     },
     "plain_text": "Here is a trick that interior designers use: cut a piece of paper or newspaper to the exact dimensions of the print size you are considering. Tape it to the wall where you plan to hang the artwork. Live with it for a day or two. You will quickly get a sense of whether the size feels right for the space — and it costs nothing to test.",
     "href": null
    }
   ],
   "icon": null,
   "color": "default"
  },
  "archived": false
 },

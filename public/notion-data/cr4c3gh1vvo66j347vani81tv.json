  {
    "object": "block",
    "id": "md-7",
    "type": "paragraph",
    "has_children": false,
    "paragraph": {
      "rich_text": [
        {
          "type": "text",
          "plain_text": "Asked what a curated gallery offers that a big poster retailer doesn't, I put it simply: \"it comes down to provenance, discovery and support for the artist.\" Provenance, because you know who made it: each print is a specific work by a named living artist. Discovery, because we help you find artists you might never have come across. Support, because a share of every sale goes to the artist, and it's another way for them to earn from their work: \"When you buy a Dybendal from us, Ingunn is paid for it.\"",
          "href": null,
          "text": {
            "content": "Asked what a curated gallery offers that a big poster retailer doesn't, I put it simply: \"it comes down to provenance, discovery and support for the artist.\" Provenance, because you know who made it: each print is a specific work by a named living artist. Discovery, because we help you find artists you might never have come across. Support, because a share of every sale goes to the artist, and it's another way for them to earn from their work: \"When you buy a Dybendal from us, Ingunn is paid for it.\"",
            "link": null
